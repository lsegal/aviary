{
	"files": {
		"includes": [
			"docs/**",
			"web/**",
			"*.ts",
			"*.js",
			"!web/dist",
			"!web/e2e/helpers/toolArguments.json",
			"!docs/**/dist",
			"!docs/**/dist",
			"!docs/**/.vitepress/cache",
			"!web/node_modules",
			"!node_modules",
			"!**/*.css"
		]
	},
	"overrides": [
		{
			"includes": ["web/e2e/*.spec.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@playwright/test": "Import from ./helpers/test so the spec records E2E coverage."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.vue"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
