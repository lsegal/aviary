{
  "name": "claude",
  "binary": "claude",
  "levels": ["low", "medium", "high"],
  "env": {"CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0"},
  "defaultModel": "sonnet",
  "session": {"assign": "aviary"},
  "output": {"format": "stream-json"},
  "wakeup": {
    "type": "type",
    "event": "assistant",
    "calls": "message.content[]",
    "name": "name",
    "tool": "ScheduleWakeup",
    "id": "id",
    "input": "input",
    "delay": "delaySeconds",
    "prompt": "prompt",
    "reason": "reason",
    "stop": "stop",
    "rejected": {"event": "user", "results": "message.content[]", "id": "tool_use_id", "error": "is_error"}
  },
  "configHome": {
    "env": "CLAUDE_CONFIG_DIR",
    "default": "~/.claude",
    "private": [".claude.json"],
    "outside": {".claude.json": "~/.claude.json"},
    "storageEnv": "CLAUDE_SECURESTORAGE_CONFIG_DIR",
    "trust": {"file": ".claude.json", "path": ["projects", "{dir}", "hasTrustDialogAccepted"]}
  },
  "quota": {"reader": "claude"},
  "skills": {"target": "claude-code"},
  "promptStdin": [],
  "doctor": {
    "auth": ["{binary}", "auth", "status"],
    "signedInJSON": "loggedIn",
    "authDetailJSON": "authMethod",
    "knownModels": ["opus", "sonnet", "haiku", "claude-opus-5-5"],
    "modelsNote": "known Claude aliases and model ids; the CLI may accept others"
  },
  "approval": {
    "read-only": ["--permission-mode", "dontAsk"],
    "auto": ["--permission-mode", "auto"],
    "full": ["--dangerously-skip-permissions"]
  },
  "extraDir": {
    "read-only": ["--add-dir", "{dir}"],
    "auto": ["--add-dir", "{dir}", "--allowedTools", "Edit(/{dirPosix}/**)"]
  },
  "permissions": {
    "read-only": {
      "denyCommand": ["--disallowedTools", "Bash{commandSpec}", "--disallowedTools", "PowerShell{commandSpec}"],
      "denyPath": ["--disallowedTools", "Read(/{pathPosix})", "--disallowedTools", "Edit(/{pathPosix})"]
    },
    "auto": {
      "allowCommand": ["--allowedTools", "Bash{commandSpec}", "--allowedTools", "PowerShell{commandSpec}"],
      "allowPath": ["--add-dir", "{dir}", "--allowedTools", "Edit(/{pathPosix})"],
      "denyCommand": ["--disallowedTools", "Bash{commandSpec}", "--disallowedTools", "PowerShell{commandSpec}"],
      "denyPath": ["--disallowedTools", "Read(/{pathPosix})", "--disallowedTools", "Edit(/{pathPosix})"]
    },
    "full": {
      "denyCommand": ["--disallowedTools", "Bash{commandSpec}", "--disallowedTools", "PowerShell{commandSpec}"],
      "denyPath": ["--disallowedTools", "Read(/{pathPosix})", "--disallowedTools", "Edit(/{pathPosix})"]
    }
  },
  "args": {
    "run": [
      {"args": ["-p"]},
      {"when": "session", "args": ["--session-id", "{session}"]},
      {"args": ["{approval}"]},
      {"when": "remoteControl", "args": ["--settings", "{settings}", "--rc", "{sessionName}"]},
      {"when": "model", "args": ["--model", "{model}"]},
      {"when": "level", "args": ["--effort", "{level}"]},
      {"args": ["--output-format", "stream-json", "--verbose"]},
      {"args": ["{prompt}"]}
    ],
    "resume": [
      {"args": ["-p", "--resume", "{session}"]},
      {"args": ["{approval}"]},
      {"when": "remoteControl", "args": ["--settings", "{settings}", "--rc", "{sessionName}"]},
      {"args": ["--output-format", "stream-json", "--verbose"]},
      {"args": ["{prompt}"]}
    ],
    "vision": [
      {"args": ["-p"]},
      {"args": ["{approval}"]},
      {"when": "model", "args": ["--model", "{model}"]},
      {"when": "level", "args": ["--effort", "{level}"]},
      {"args": ["{prompt}"]}
    ]
  }
}
