{
  "name": "codex",
  "binary": "codex",
  "levels": ["low", "medium", "high"],
  "defaultModel": "gpt-6.1-terra",
  "session": {
    "assign": "capture",
    "capture": "(?i)session id:\\s*([0-9a-f]{8}-[0-9a-f-]{27,})",
    "clearOnResumeFailure": true
  },
  "output": {"format": "codex-json"},
  "quota": {"reader": "codex"},
  "skills": {"target": "codex"},
  "doctor": {
    "auth": ["{binary}", "login", "status"],
    "signedIn": "(?im)^\\s*Logged in",
    "authDetail": "(?im)^\\s*Logged in using\\s+(.+)$",
    "models": ["{binary}", "debug", "models"],
    "modelsJSON": "models[visibility=list].slug"
  },
  "configHome": {"env": "CODEX_HOME", "default": "~/.codex", "private": ["config.toml"]},
  "promptStdin": ["-"],
  "approval": {
    "read-only": ["-c", "sandbox_mode=read-only"],
    "auto": ["-c", "sandbox_mode=workspace-write", "-c", "sandbox_workspace_write.network_access=true"],
    "full": ["--dangerously-bypass-approvals-and-sandbox"]
  },
  "extraDir": {"read-only": ["-c", "sandbox_workspace_write.writable_roots=[{dirQuoted}]"]},
  "args": {
    "run": [
      {"args": ["exec", "--json"]},
      {"when": "noCheckout", "args": ["--skip-git-repo-check"]},
      {"args": ["{approval}"]},
      {"when": "model", "args": ["--model", "{model}"]},
      {"when": "level", "args": ["-c", "model_reasoning_effort={level}"]},
      {"args": ["{prompt}"]}
    ],
    "resume": [
      {"args": ["exec", "resume", "--json"]},
      {"when": "noCheckout", "args": ["--skip-git-repo-check"]},
      {"args": ["{approval}"]},
      {"when": "model", "args": ["--model", "{model}"]},
      {"when": "level", "args": ["-c", "model_reasoning_effort={level}"]},
      {"args": ["{session}", "{prompt}"]}
    ],
    "vision": [
      {"args": ["exec", "--skip-git-repo-check", "--image", "{image}"]},
      {"args": ["{approval}"]},
      {"when": "model", "args": ["--model", "{model}"]},
      {"when": "level", "args": ["-c", "model_reasoning_effort={level}"]},
      {"args": ["{prompt}"]}
    ]
  }
}
