{
  "name": "gemini",
  "binary": "gemini",
  "minVersion": "0.58.0",
  "defaultModel": "gemini-3.5-flash",
  "levels": [],
  "env": {"GEMINI_CLI_TRUST_WORKSPACE": "true"},
  "session": {"assign": "aviary"},
  "output": {"format": "gemini-json"},
  "missingSession": ["no previous sessions found", "invalid session identifier"],
  "skills": {"target": "gemini-cli"},
  "doctor": {
    "models": ["{binary}", "--acp"],
    "modelsStdin": [
      "{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{\"protocolVersion\":1,\"clientCapabilities\":{\"fs\":{\"readTextFile\":false,\"writeTextFile\":false}}}}",
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"session/new\",\"params\":{\"cwd\":\".\",\"mcpServers\":[]}}"
    ],
    "modelsJSON": "result.models.availableModels[].modelId",
    "timeout": "45s"
  },
  "mcp": {
    "env": {"GEMINI_CLI_SYSTEM_SETTINGS_PATH": "{mcpFile}"},
    "file": {
      "mcpServers": {
        "{mcpName}": {
          "httpUrl": "{mcpUrl}",
          "headers": {"Authorization": "Bearer ${{mcpTokenEnv}}"},
          "trust": true,
          "timeout": "{mcpTimeoutMs}"
        }
      },
      "policyPaths": ["{mcpAllowFile}"]
    },
    "allowFile": {
      "extension": ".toml",
      "lines": [
        "[[rule]]",
        "toolName = \"*\"",
        "mcpName = \"{mcpName}\"",
        "decision = \"allow\"",
        "priority = 100",
        "modes = [\"plan\"]"
      ]
    },
    "toolPrefix": "mcp_{mcpName}_"
  },
  "systemPrompt": {"env": {"GEMINI_SYSTEM_MD": "{systemPromptFile}"}},
  "approval": {
    "read-only": ["--approval-mode", "plan"],
    "auto": ["--approval-mode", "auto_edit"],
    "full": ["--yolo"]
  },
  "args": {
    "run": [
      {"when": "session", "args": ["--session-id", "{session}"]},
      {"args": ["{approval}"]},
      {"when": "model", "args": ["--model", "{model}"]},
      {"args": ["--output-format", "stream-json"]},
      {"args": ["-p", "{prompt}"]}
    ],
    "resume": [
      {"args": ["--resume", "{session}"]},
      {"args": ["{approval}"]},
      {"args": ["--output-format", "stream-json"]},
      {"args": ["-p", "{prompt}"]}
    ],
    "vision": [
      {"args": ["{approval}"]},
      {"when": "model", "args": ["--model", "{model}"]},
      {"args": ["-p", "{prompt}"]}
    ]
  }
}
