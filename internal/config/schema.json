{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aviary Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 16677,
          "x-label": "Port",
          "x-placeholder": "16677",
          "x-order": 1,
          "description": "HTTP(S) listen port. Defaults to 16677."
        },
        "external_access": {
          "type": "boolean",
          "x-label": "External access",
          "x-order": 2,
          "description": "Bind the Aviary server to 0.0.0.0 instead of localhost."
        },
        "no_tls": {
          "type": "boolean",
          "x-label": "Disable TLS",
          "x-order": 3,
          "description": "Disable TLS and serve plain HTTP. Intended for trusted local or reverse-proxy environments."
        },
        "disable_token_auth": {
          "type": "boolean",
          "x-label": "Disable token authentication",
          "x-order": 7,
          "description": "Skip bearer-token checks on the HTTP, WebSocket, and MCP endpoints, so anyone who can reach the server can use it. Not recommended."
        },
        "auto_update": {
          "type": "boolean",
          "default": false,
          "x-label": "Update automatically",
          "x-order": 6,
          "description": "Install new Aviary releases automatically as soon as they are available. Running jobs are checkpointed and resume after the restart."
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cert": {
              "type": "string",
              "x-label": "TLS cert path",
              "x-placeholder": "/path/to/cert.pem",
              "x-order": 4,
              "description": "Path to TLS certificate file (PEM). Leave empty to use an auto-generated self-signed cert."
            },
            "key": {
              "type": "string",
              "x-label": "TLS key path",
              "x-placeholder": "/path/to/key.pem",
              "x-order": 5,
              "description": "Path to TLS private key file (PEM). Leave empty to use an auto-generated self-signed key."
            }
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "projects": {
            "description": "The GitHub projects this agent owns. A project belongs to exactly one agent, whose model and fallbacks run its jobs; their settings are the shared top-level projects section.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "list": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "target"
                  ],
                  "properties": {
                    "target": {
                      "type": "string",
                      "description": "owner/repo, a repository URL, a GitHub Project board, or a Discussions board."
                    },
                    "reports": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["agent", "targets"],
                      "description": "Reports this project's job lifecycle events through an Aviary agent's channels. Off when unset.",
                      "properties": {
                        "agent": {
                          "type": "string",
                          "description": "The Aviary agent whose channels deliver the reports."
                        },
                        "targets": {
                          "type": "array",
                          "items": { "type": "string" },
                          "description": "Where reports go: <channel type>:<configured channel id>:<delivery id>, or session:<name>."
                        },
                        "events": {
                          "type": "array",
                          "items": { "type": "string", "enum": ["merged", "failed", "waiting"] },
                          "description": "Job events to report. Empty reports all of them."
                        }
                      }
                    }
                  }
                },
                "x-label": "Projects",
                "x-order": 1,
                "description": "Watched projects."
              }
            }
          },
          "model": { "type": "string" },
          "memory": { "type": "string" },
          "rules": {
            "type": "string",
            "description": "Inline operating rules or a path to a markdown file whose contents are injected into the agent system prompt."
          },
          "memory_tokens": {
            "type": "integer",
            "minimum": 1,
            "default": 4000,
            "description": "Maximum tokens of memory context to include in each prompt."
          },
          "compact_keep": {
            "type": "integer",
            "minimum": 1,
            "default": 200,
            "description": "Number of memory entries allowed before the pool is compacted into a single summary."
          },
          "fallbacks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "preset": {
                "type": "string",
                "enum": ["full", "standard", "minimal"],
                "description": "Maximum tool groups this agent may use. Defaults to standard when omitted."
              },
              "tools": {
                "type": "array",
                "items": { "type": "string" }
              },
              "disabled_tools": {
                "type": "array",
                "items": { "type": "string" }
              },
              "filesystem": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "allowed_paths": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              },
              "exec": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "allowed_commands": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "shell_interpolate": { "type": "boolean", "default": false },
                  "shell": { "type": "string" }
                }
              }
            }
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "type": {
                  "type": "string",
                  "enum": ["slack", "discord", "signal"]
                },
                "token": { "type": "string" },
                "id": { "type": "string" },
                "url": {
                  "type": "string",
                  "description": "TCP address of an existing signal-cli JSON-RPC daemon (e.g. 127.0.0.1:7583). If omitted for Signal channels, signal-cli is launched and managed automatically."
                },
                "show_typing": { "type": "boolean" },
                "separate_top_level_sessions": { "type": "boolean" },
                "reply_to_replies": { "type": "boolean" },
                "react_to_emoji": { "type": "boolean" },
                "send_read_receipts": { "type": "boolean" },
                "model": { "type": "string" },
                "fallbacks": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "disabled_tools": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "allow_from": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "object",
                        "required": ["from"],
                        "properties": {
                          "enabled": { "type": "boolean" },
                          "from": { "type": "string" },
                          "allowed_groups": {
                            "type": "string",
                            "description": "Comma-separated group/channel IDs. Use '*' to allow any group. When empty, only matches direct messages."
                          },
                          "mention_prefixes": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "Glob patterns matched against group message text. At least one must match to forward the message."
                          },
                          "respond_to_mentions": { "type": "boolean" },
                          "restrict_tools": {
                            "type": "array",
                            "items": { "type": "string" }
                          },
                          "model": { "type": "string" },
                          "fallbacks": {
                            "type": "array",
                            "items": { "type": "string" }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "name": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["prompt", "script", "project"]
                },
                "schedule": { "type": "string" },
                "start_at": { "type": "string", "format": "date-time" },
                "run_once": { "type": "boolean", "default": false },
                "trigger": { "type": "string", "enum": ["once", "interval", "daily", "weekly", "cron"] },
                "every": { "type": "string" },
                "at": { "type": "string" },
                "days": { "type": "string" },
                "timezone": { "type": "string" },
                "overlap": { "type": "string", "enum": ["queue", "skip"], "default": "queue" },
                "missed": { "type": "string", "enum": ["skip", "run_once"], "default": "skip" },
                "idle_timeout": { "type": "string", "description": "How long a prompt run may go without output before it fails, e.g. 30m; \"0\" disables it.", "default": "15m" },
                "watch": { "type": "string" },
                "prompt": { "type": "string" },
                "script": { "type": "string" },
                "target": { "type": "string" },
                "project": { "type": "string" },
                "cli": { "type": "string" }
              },
              "allOf": [
                {
                  "anyOf": [
                    { "required": ["schedule"] },
                    { "required": ["every"] },
                    { "required": ["at"] },
                    { "required": ["start_at"] },
                    { "required": ["watch"] }
                  ]
                },
                {
                  "if": {
                    "properties": { "type": { "const": "script" } }
                  },
                  "then": {
                    "required": ["script"]
                  }
                },
                {
                  "if": {
                    "properties": { "type": { "const": "prompt" } }
                  },
                  "then": {
                    "required": ["prompt"]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "auth": { "type": "string" },
              "base_uri": { "type": "string" }
            }
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "x-label": "Default model",
              "x-placeholder": "claude-opus-5-5",
              "x-order": 1,
              "description": "Fallback model used when an agent does not specify one."
            },
            "fallbacks": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "cli_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "x-label": "CLI definitions",
          "description": "CLI definitions keyed by agent name: overrides of the built-ins field by field (null drops a field) and new agents."
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binary": {
          "type": "string",
          "x-label": "Browser binary",
          "x-placeholder": "auto-detected",
          "x-order": 1,
          "description": "Path to Chrome/Chromium binary. Leave empty to auto-detect."
        },
        "cdp_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 9222,
          "x-label": "CDP port",
          "x-placeholder": "9222",
          "x-order": 2,
          "description": "Chrome DevTools Protocol port used to attach to an existing browser instance."
        },
        "profile_directory": {
          "type": "string",
          "x-label": "Profile directory",
          "x-placeholder": "Aviary",
          "x-order": 3,
          "description": "Chrome profile folder name in the browser's default user data directory (e.g. 'Default', 'Profile 1', 'work'). Defaults to 'Aviary' if unset."
        },
        "headless": {
          "type": "boolean",
          "default": false,
          "x-label": "Headless mode",
          "x-order": 4,
          "description": "Run the browser without a visible window. Defaults to false so the browser is visible."
        },
        "reuse_tabs": {
          "type": "boolean",
          "default": true,
          "x-label": "Reuse matching tabs",
          "x-order": 5,
          "description": "When enabled, browser_open reuses an existing page tab if the requested URL exactly matches the current URL. Defaults to true."
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brave_api_key": {
              "type": "string",
              "x-label": "Brave API key ref",
              "x-placeholder": "auth:brave_api_key",
              "x-order": 1,
              "description": "Brave Search API key or auth store reference (e.g. 'auth:brave_api_key'). Leave empty to disable web search."
            }
          }
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": {
          "oneOf": [
            { "type": "string", "enum": ["auto"] },
            { "type": "integer", "minimum": 1 }
          ],
          "x-label": "Concurrency",
          "x-placeholder": "auto",
          "x-order": 1,
          "description": "Number of parallel task workers. Use 'auto' (or leave empty) to match the CPU count."
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "settings": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "description": "How much CLI providers may do without asking. Each CLI launch translates its surface's mode into that CLI's own permission flags; CLI settings files are never modified.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["read-only", "auto", "full"],
          "default": "auto",
          "x-label": "Approval mode",
          "x-order": 1,
          "description": "General approval mode, used wherever no surface override applies. read-only: read and inspect only; auto: work in the workspace without asking, with the CLI's own sandbox or checks refusing riskier actions; full: no sandbox or permission checks."
        },
        "chat": {
          "type": "string",
          "enum": ["read-only", "auto", "full"],
          "x-label": "Chat approval mode",
          "x-order": 2,
          "description": "Override for CLI-backed chat turns (web UI chat and the Code Loop prompt chat). Empty follows mode."
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": false,
      "description": "The one set of Code Loop settings, shared by every project of every agent. The projects themselves are listed under the agents that own them.",
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 0,
          "x-label": "Concurrency",
          "x-order": 2,
          "description": "Jobs that run at once across every project. Defaults to 3."
        },
        "interval": {
          "type": "string",
          "x-label": "Poll interval",
          "x-order": 3,
          "description": "Time between GitHub polls, as a duration such as 30s. Defaults to 30s."
        },
        "delivery": {
          "type": "string",
          "enum": [
            "poll",
            "webhook"
          ],
          "x-label": "Delivery",
          "x-order": 4,
          "description": "How GitHub changes arrive: poll (default) or webhook (an ngrok tunnel and repository webhooks)."
        },
        "ready_state": {
          "type": "string",
          "x-label": "Ready state",
          "x-order": 6,
          "description": "Project board status that marks an item ready. Defaults to Todo or Ready."
        },
        "filter": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-label": "Issue filter",
          "x-order": 7,
          "description": "GitHub issue search filter. Defaults to assignee:@me."
        },
        "all_issues": {
          "type": "boolean",
          "x-label": "All issues",
          "x-order": 8,
          "description": "Drop the issue filter and pick up every open issue."
        },
        "allowed_commenters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-label": "Allowed commenters",
          "x-order": 9,
          "description": "GitHub logins whose comments steer jobs. Defaults to the authenticated gh user."
        },
        "approval_mode": {
          "type": "string",
          "enum": ["read-only", "auto", "full"],
          "x-label": "Approval mode",
          "x-order": 13,
          "description": "Code Loop's approval-mode override for the CLI runs it launches. Empty follows approval.mode."
        },
        "yolo": {
          "type": "boolean",
          "x-label": "YOLO",
          "x-order": 13,
          "description": "Disable the CLI providers' sandboxes and permission checks."
        },
        "no_merge": {
          "type": "boolean",
          "x-label": "No merge",
          "x-order": 14,
          "description": "Leave finished gh-fix pull requests ready for a human to merge."
        },
        "no_changelog": {
          "type": "boolean",
          "x-label": "No changelog",
          "x-order": 15,
          "description": "Skip changelog entries in gh-fix pull requests."
        },
        "unblock_interval": {
          "type": "string",
          "x-label": "Unblock interval",
          "x-order": 16,
          "description": "How often the stuck-job watchdog runs, such as 15m; 0 turns it off. Defaults to 15m."
        },
        "unblock_agent": {
          "type": "string",
          "x-label": "Unblock agent",
          "x-order": 17,
          "description": "Agent spec for the watchdog's unblock call. Defaults to the coding agent."
        },
        "unblock_model": {
          "type": "string",
          "x-label": "Unblock model",
          "x-order": 18,
          "description": "Model for the watchdog's unblock call."
        },
        "chat_model": {
          "type": "string",
          "x-label": "Prompt chat model",
          "x-order": 19,
          "description": "Model of the built-in Code Loop agent behind the board's prompt chat. Defaults to models.defaults."
        },
        "chat_fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-label": "Prompt chat fallbacks",
          "x-order": 20,
          "description": "Fallback models of the built-in Code Loop agent, tried in order."
        },
        "temp_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-label": "Clone directories",
          "x-order": 21,
          "description": "Absolute directories new clones go in, tried in order. Defaults to the system temp directory."
        },
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "listen": {
              "type": "string",
              "description": "Webhook listener address. Defaults to :0."
            },
            "path": {
              "type": "string",
              "description": "Webhook path. Defaults to /webhook."
            },
            "secret": {
              "type": "string",
              "description": "Webhook signature secret."
            },
            "ngrok_binary": {
              "type": "string",
              "description": "ngrok executable; fetched through npx when not installed."
            }
          },
          "x-label": "Webhook",
          "x-order": 22,
          "description": "Webhook delivery settings."
        }
      }
    }
  }
}
