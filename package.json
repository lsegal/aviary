{
	"name": "aviary",
	"version": "0.6.2",
	"private": true,
	"packageManager": "pnpm@8.15.9",
	"type": "module",
	"pnpm": {
		"supportedArchitectures": {
			"os": [
				"current",
				"linux"
			],
			"cpu": [
				"current",
				"x64"
			],
			"libc": [
				"current",
				"glibc"
			]
		}
	},
	"scripts": {
		"claude": "claude --dangerously-skip-permissions",
		"codex": "codex --dangerously-bypass-approvals-and-sandbox",
		"dev": "concurrently -n web,doc,srv -c cyan,yellow,green \"vite --host 0.0.0.0\" \"pnpm docs:dev\" \"go tool wgo run ./cmd/aviary serve\"",
		"docs:dev": "pnpm --dir docs dev",
		"docs:build": "pnpm --dir docs build",
		"docs:preview": "pnpm --dir docs preview",
		"build": "pnpm run build:web && pnpm run build:go",
		"build:web": "vue-tsc --noEmit && vite build && pnpm run build:copy",
		"build:go": "node scripts/build-go.mjs",
		"build:copy": "node scripts/build-webdist.mjs",
		"build:release": "pnpm run build:web && node scripts/build-release.mjs",
		"build:generate": "go generate ./...",
		"build:clean": "node scripts/clean.mjs",
		"preview": "vite preview",
		"lint": "concurrently -n go,web \"pnpm lint:go\" \"pnpm lint:web\"",
		"lint:go": "go tool golangci-lint run ./...",
		"lint:web": "concurrently -n biome,tsc \"biome check .\" \"vue-tsc --noEmit\"",
		"lint:fix": "concurrently -n biome,go \"biome check --write .\" \"gofmt -w . && go tool golangci-lint run --fix ./...\"",
		"format": "biome format --write .",
		"test": "concurrently -n go,web \"pnpm test:go\" \"pnpm test:e2e\"",
		"test:go": "go test ./...",
		"test:e2e": "pnpm exec playwright install && playwright test",
		"test:e2e:ui": "playwright test --ui",
		"package": "pnpm exec vpr run -f pnpm package:stage",
		"package:stage": "pnpm install && node scripts/package.mjs",
		"release": "pnpm exec vpr run -c pnpm release:stage && git pull",
		"release:stage": "pnpm install && node scripts/release.mjs",
		"release:major": "cross-env VERSION=major pnpm release:prepare && pnpm release",
		"release:minor": "cross-env VERSION=minor pnpm release:prepare && pnpm release",
		"release:patch": "cross-env VERSION=patch pnpm release:prepare && pnpm release"
	},
	"dependencies": {
		"@heroicons/vue": "^2.2.0",
		"marked": "^18.0.7",
		"pinia": "^3.0.4",
		"radix-vue": "^1.9.17",
		"simple-icons": "^16.25.0",
		"vue": "^3.5.40",
		"vue-router": "^5.0.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^25.6.0",
		"@vitejs/plugin-vue": "^6.0.7",
		"autoprefixer": "^10.5.4",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"execa": "^10.0.1",
		"postcss": "^8.5.23",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.1.4",
		"vpr": "^1.4.5",
		"vue-tsc": "^3.3.8"
	}
}
